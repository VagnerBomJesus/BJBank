<?xml version="1.0" encoding="utf-8"?>
<!--
  BJBank Network Security Config

  Em release: bloqueia cleartext (sem HTTPS).
  Em debug: permite cleartext localhost para emulador testes.

  Pinning ao Supabase pode ser adicionado abaixo (substituir <pin> placeholder
  pelos hashes SHA-256 do certificado quando obtidos).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Emulador / dev: permite cleartext localhost para testes -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- Supabase: HTTPS obrigatório (TLS 1.3) -->
    <domain-config>
        <domain includeSubdomains="true">supabase.co</domain>
        <domain includeSubdomains="true">supabase.com</domain>
        <!-- TODO: adicionar certificate pinning quando obter os hashes
        <pin-set expiration="2027-01-01">
            <pin digest="SHA-256">PLACEHOLDER_SHA256_HASH</pin>
            <pin digest="SHA-256">PLACEHOLDER_BACKUP_HASH</pin>
        </pin-set>
        -->
    </domain-config>
</network-security-config>
