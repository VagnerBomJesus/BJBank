        <mxCell id="k-m1" value="1: nonce = Random.secure(32B)" style="text;html=1;strokeColor=none;fillColor=#fffbe6;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10" vertex="1" parent="1">
