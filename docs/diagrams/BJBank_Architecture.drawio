        <mxCell id="t-tx" value="public.transactions&#xa;━━━━━━━━━━━━━━━&#xa;PK  id : uuid&#xa;FK  account_id : uuid&#xa;conta_origem_iban : text&#xa;conta_destino_iban : text&#xa;montante : numeric&#xa;descricao : text&#xa;timestamp : timestamptz&#xa;nonce : bytea&#xa;assinatura_mldsa : bytea&#xa;cliente_dsa_public : bytea&#xa;session_id : text&#xa;estado : text" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="680" y="260" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="t-sess" value="public.sessions&#xa;━━━━━━━━━━━━━&#xa;PK  id : text  (UUID)&#xa;FK  user_id : uuid&#xa;shared_secret_base64 : text&#xa;expires_at : bigint  (epoch ms)&#xa;last_serial : integer  (anti-replay v2)&#xa;created_at : timestamptz" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="340" y="260" width="280" height="140" as="geometry" />
