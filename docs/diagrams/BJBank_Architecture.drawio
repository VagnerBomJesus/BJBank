        <mxCell id="leg-er" value="Convencoes ER:&#xa;PK = Primary Key &#160;&#160; FK = Foreign Key &#160;&#160; UK = Unique Key&#xa;Cardinalidade Crow's Foot: 1:N = um para muitos &#160;&#160; 1:1 = um para um&#xa;Cores: cinza = sistema &#160;&#160; azul = entidades core &#160;&#160; verde = transacional&#xa;amarelo = sessao PQC &#160;&#160; vermelho = chaves cripto &#160;&#160; roxo = MBWay" style="text;html=1;strokeColor=#666;fillColor=#fffbe6;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10" vertex="1" parent="1">
