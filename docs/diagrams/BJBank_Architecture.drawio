            <Array as="points">
              <mxPoint x="900" y="160" />
              <mxPoint x="640" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="notes" value="NOTAS:&#xa;• verify_dsa server-side e fallback apenas; Android usa sempre verify LOCAL (DevicePqcService.verifyDsa) — fim do trust circular.&#xa;• TTL local = 50 min (margem face ao server expires_at = 1h) — evita 410 em transferencias.&#xa;• Sessao expirada ⇒ novo handshake; sessions.last_serial reinicia a 0 no servidor; cliente reinicia _serialPorSessao[sessionId].&#xa;• A entrada principal e Idle ⇒ Bootstrapping ⇒ Handshaking ⇒ Verifying ⇒ Active." style="text;html=1;strokeColor=#666;fillColor=#fffbe6;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="1050" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

