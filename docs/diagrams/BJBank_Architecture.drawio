        </mxCell>
        <mxCell id="k-m3" value="3: kemPair = ml_kem768.keygen(seed)&#xa;serverKemPub (1184B), kemSecret (2400B)&#xa;4: transcript = clientNonce ‖ serverKemPub ‖ serverDsaPub ‖ sessionId&#xa;5: signature = ml_dsa65.sign(serverDsaPriv, transcript)" style="text;html=1;strokeColor=#0d6efd;fillColor=#cfe2ff;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=6;spacingTop=4" vertex="1" parent="1">
