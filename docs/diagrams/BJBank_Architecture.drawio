        <mxCell id="t-auth" value="auth.users&#xa;━━━━━━━━━&#xa;PK  id : uuid&#xa;email : text&#xa;raw_user_meta_data : jsonb" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t-users" value="public.users&#xa;━━━━━━━━━━━━&#xa;PK FK  id : uuid&#xa;email : text&#xa;nome_completo : text&#xa;phone : text  (+351...)&#xa;photo_url : text&#xa;pqc_public_key_base64 : text   (legado v1.1)&#xa;created_at : timestamptz" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="340" y="80" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="t-acc" value="public.accounts&#xa;━━━━━━━━━━━━━&#xa;PK  id : uuid&#xa;FK  user_id : uuid&#xa;UK  iban : text  (PT50...)&#xa;nome : text&#xa;saldo : numeric&#xa;moeda : text  (EUR)&#xa;tipo : text  (CORRENTE | POUPANCA)&#xa;created_at : timestamptz" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="680" y="80" width="280" height="150" as="geometry" />
