        <mxCell id="sed10" value="bootstrap FALHA" style="endArrow=classic;html=1;fontSize=10;strokeColor=#b85450" edge="1" parent="1" source="s-boot" target="s-fail">
          <mxGeometry relative="1" as="geometry">
