        </mxCell>
        <mxCell id="t-mb" value="public.mbway_phones&#xa;━━━━━━━━━━━━━━━&#xa;PK  phone : text  (+351...)&#xa;UK FK  account_id : uuid&#xa;FK  user_id : uuid&#xa;ativo : boolean&#xa;criada_em : timestamptz" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;fontStyle=1" vertex="1" parent="1">
