        </mxCell>
        <mxCell id="k-m5" value="7: {mode:'kem', sessionId,&#xa;serverKemPub, serverDsaPub, signature}" style="endArrow=open;html=1;dashed=1;fontSize=10" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="730" y="350" as="sourcePoint" /><mxPoint x="145" y="350" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="k-m6" value="8: verifyDsa(serverDsaPub, transcript, sig)" style="endArrow=classic;html=1;fontSize=10" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="145" y="390" as="sourcePoint" /><mxPoint x="330" y="390" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="k-m7" value="9: invokeMethod('verifyDsa')" style="endArrow=classic;html=1;fontSize=10" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="330" y="420" as="sourcePoint" /><mxPoint x="510" y="420" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="k-m8" value="10: MLDSASigner.init(forSigning=false)&#xa;.update(transcript).verifySignature(sig) → true" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;spacingLeft=6" vertex="1" parent="1">
          <mxGeometry x="430" y="440" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="k-m9" value="11: true" style="endArrow=open;html=1;dashed=1;fontSize=10" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="495" as="sourcePoint" /><mxPoint x="145" y="495" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="k-m10" value="12: kemEncapsulate(serverKemPub)" style="endArrow=classic;html=1;fontSize=10" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="145" y="530" as="sourcePoint" /><mxPoint x="330" y="530" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="k-m11" value="13: invokeMethod('kemEncapsulate')" style="endArrow=classic;html=1;fontSize=10" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="330" y="560" as="sourcePoint" /><mxPoint x="510" y="560" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="k-m12" value="14: MLKEMGenerator.generateEncapsulated(serverKemPub)&#xa;→ encapsulated.encapsulation (ciphertext 1088B)&#xa;→ encapsulated.secret (sharedSecret 32B) [FICA NO DEVICE]" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=6;spacingTop=4;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="430" y="580" width="430" height="60" as="geometry" />
        </mxCell>
        <mxCell id="k-m13" value="15: {ciphertext, sharedSecret}" style="endArrow=open;html=1;dashed=1;fontSize=10" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="510" y="655" as="sourcePoint" /><mxPoint x="145" y="655" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="k-m14" value="16: POST {sessionId, ciphertext}" style="endArrow=classic;html=1;fontSize=10" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="145" y="690" as="sourcePoint" /><mxPoint x="990" y="690" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="k-m15" value="17: SELECT kemSecret WHERE id=sessionId" style="endArrow=classic;html=1;fontSize=10" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="990" y="715" as="sourcePoint" /><mxPoint x="1240" y="715" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="k-m16" value="18: rejeita se TTL > 5min&#xa;19: sharedSecret = ml_kem768.decapsulate(ciphertext, kemSecret)&#xa;20: INSERT sessions (sharedSecret, expires_at=now+1h)&#xa;21: DELETE pending_kem_sessions WHERE id=sessionId  [PRIVADA DESTRUIDA]" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=6;spacingTop=4;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="940" y="730" width="450" height="80" as="geometry" />
        </mxCell>
        <mxCell id="k-m17" value="22: {ok: true, sessionId}" style="endArrow=open;html=1;dashed=1;fontSize=10" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="990" y="830" as="sourcePoint" /><mxPoint x="145" y="830" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="k-leg" value="🔥 PROPRIEDADE FUNDAMENTAL: sharedSecret NUNCA atravessa a rede em claro. Atacante de rede que grave hoje&#xa;e quebre X25519 amanha SO ve clientNonce + serverKemPub + ciphertext — precisa de quebrar TAMBEM ML-KEM-768.&#xa;Janela residual: 5min em que kemSecret existe em pending_kem_sessions (se atacante obtem service_role nessa janela)." style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="60" y="870" width="1340" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="9. Comparativo Legacy vs KEM" id="cmp">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t9" value="Comparativo — Modo Legacy vs Modo KEM (PFS pos-quantico)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="1000" height="40" as="geometry" />
        </mxCell>

        <mxCell id="leg-box" value="🔴 MODO LEGACY (iOS atual / Android antes v1.3.0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="540" height="640" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="1. Cliente envia clientNonce 32B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="leg-arr1" style="endArrow=classic;html=1;" edge="1" parent="1" source="leg1" target="leg2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leg2" value="2. Servidor gera sharedSecret 32B random&#xa;persiste em sessions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="leg-arr2" style="endArrow=classic;html=1;" edge="1" parent="1" source="leg2" target="leg3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leg3" value="3. Servidor envia sharedSecret EM CLARO via TLS&#xa;{sharedSecretBase64, signature, serverDsaPub, sessionId}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b85450;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="leg-arr3" style="endArrow=classic;html=1;" edge="1" parent="1" source="leg3" target="leg4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leg4" value="4. Cliente verifica assinatura&#xa;Faz HKDF para derivar aesKey" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="leg-arr4" style="endArrow=classic;html=1;dashed=1;strokeColor=#b85450" edge="1" parent="1" source="leg4" target="leg5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leg5" value="⚠️ HNDL APLICAVEL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;verticalAlign=middle;align=center" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="leg6" value="Cenario: atacante de rede grava TLS hoje.&#xa;Daqui a 5-10 anos:&#xa;1. Computador quantico quebra X25519&#xa;2. Decifra TLS retroativamente&#xa;3. Extrai sharedSecretBase64 do JSON em claro&#xa;4. HKDF(sharedSecret, sessionId publico) → aesKey&#xa;5. Decifra TODOS os envelopes da sessao&#xa;6. Le IBANs, montantes, descricoes, timestamps" style="text;html=1;strokeColor=#b85450;fillColor=#fff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=8;spacingTop=4" vertex="1" parent="1">
          <mxGeometry x="60" y="490" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="leg7" value="❌ Confidencialidade depende SO do TLS classico&#xa;❌ ML-KEM no servidor nao ajuda (so vence quem grava entre cliente e servidor)&#xa;❌ Tese NAO pode chamar a isto 'PFS pos-quantico'" style="text;html=1;strokeColor=#b85450;fillColor=#f8d7da;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacingLeft=8;spacingTop=4;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="kem-box" value="🟢 MODO KEM v1.3.0 (Android)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="540" height="640" as="geometry" />
        </mxCell>
        <mxCell id="kem1" value="1. Cliente envia clientNonce 32B + clientKemCapability: true" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="620" y="130" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kem-arr1" style="endArrow=classic;html=1;" edge="1" parent="1" source="kem1" target="kem2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="kem2" value="2. Servidor gera par ML-KEM-768 efemero&#xa;Persiste APENAS a privada em pending_kem_sessions (TTL 5min)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="620" y="200" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="kem-arr2" style="endArrow=classic;html=1;" edge="1" parent="1" source="kem2" target="kem3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="kem3" value="3. Servidor envia serverKemPub 1184B + assinatura ML-DSA&#xa;sharedSecret NAO viaja" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="620" y="280" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="kem-arr3" style="endArrow=classic;html=1;" edge="1" parent="1" source="kem3" target="kem4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="kem4" value="4. Cliente Android verifica ass. localmente&#xa;Chama PqcPlugin.kemEncapsulate(serverKemPub) LOCAL&#xa;Obtem (ciphertext 1088B, sharedSecret 32B)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="620" y="360" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="kem-arr4" style="endArrow=classic;html=1;" edge="1" parent="1" source="kem4" target="kem5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="kem5" value="5. Cliente envia SO o ciphertext (POST pqc_handshake_kem_complete)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="620" y="430" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kem-arr5" style="endArrow=classic;html=1;" edge="1" parent="1" source="kem5" target="kem6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="kem6" value="6. Servidor decapsula → mesmo sharedSecret&#xa;APAGA pending_kem_sessions (privada destruida)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="620" y="490" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="kem-arr6" style="endArrow=classic;html=1;dashed=1;strokeColor=#82b366" edge="1" parent="1" source="kem6" target="kem7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="kem7" value="✅ HNDL FALHA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;verticalAlign=middle;align=center" vertex="1" parent="1">
          <mxGeometry x="620" y="550" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kem8" value="✅ sharedSecret calculado no dispositivo&#xa;✅ Atacante de rede so ve clientNonce + serverKemPub + ciphertext&#xa;✅ Precisa quebrar TAMBEM ML-KEM-768 (lattice)&#xa;✅ Tese pode chamar a isto 'PFS pos-quantico real'" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacingLeft=8;spacingTop=4;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="620" y="600" width="500" height="80" as="geometry" />
        </mxCell>

        <mxCell id="cmp-leg" value="📌 LIMITACAO RESIDUAL: enquanto pending_kem_sessions tem a privada (TTL 5min), atacante com service_role pode comprometer&#xa;a sessao em curso. Sessoes antigas ficam seguras porque a privada ja' foi apagada. Mitigacao residual: BC-FIPS ou HSM." style="text;html=1;strokeColor=#666;fillColor=#fffbe6;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="1100" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
