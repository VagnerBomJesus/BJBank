        <mxCell id="t-fck" value="public.flutter_client_keys&#xa;━━━━━━━━━━━━━━━━━━&#xa;FK  user_id : uuid&#xa;public_key_base64 : text (NOT NULL)&#xa;secret_key_base64 : text NULL   (NULL se device)&#xa;managed_by : text  ('server' | 'device')&#xa;revoked_at : timestamptz NULL&#xa;migrated_at : timestamptz NULL&#xa;criada_em : timestamptz&#xa;━━━━━&#xa;Index parcial: WHERE revoked_at IS NULL" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;fontStyle=1" vertex="1" parent="1">
